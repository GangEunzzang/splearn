<?xml version="1.0" encoding="UTF-8" ?>
<entity-mappings xmlns="http://www.hibernate.org/xsd/orm/mapping"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://www.hibernate.org/xsd/orm/mapping
                                     https://www.hibernate.org/xsd/orm/mapping/mapping-3.1.0.xsd">

    <access>FIELD</access>

    <mapped-superclass class="tobyspring.splearn.domain.AbstractEntity" access="FIELD">
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
        </attributes>
    </mapped-superclass>

    <entity class="tobyspring.splearn.domain.member.Member" access="FIELD">
        <table name="MEMBER">
            <unique-constraint name="UK_MEMBER_EMAIL">
                <column-name>email</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="nickname">
                <column name="nickname" length="100" nullable="false"/>
            </basic>
            <basic name="passwordHash">
                <column name="password_hash" length="200" nullable="false"/>
            </basic>
            <basic name="status">
                <column name="status" length="50" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <embedded name="email"/>
        </attributes>
    </entity>

    <embeddable class="tobyspring.splearn.domain.shared.Email">
        <attributes>
            <basic name="email">
                <column name="email" length="150" nullable="false"/>
            </basic>
        </attributes>
    </embeddable>

</entity-mappings>
